#!/usr/bin/env bash
# ============================================================
# start-container — Entrypoint personalizado para Sail
#
# Extiende el script original de Laravel Sail agregando:
# - Remapeo del usuario sail al UID/GID del host
# - Fix automático de permisos en storage/ y bootstrap/cache/
# - Soporte para WWWGROUP faltante
# ============================================================

set -e

# ── 1. Remapear usuario sail al UID del host ─────────────
if [ ! -z "$WWWUSER" ]; then
    usermod -u $WWWUSER sail 2>/dev/null || true
fi

# ── 2. Remapear grupo sail al GID del host ──────────────
if [ ! -z "$WWWGROUP" ]; then
    groupmod -g $WWWGROUP sail 2>/dev/null || true
fi

# ── 3. Asegurar /.composer ──────────────────────────────
if [ ! -d /.composer ]; then
    mkdir -p /.composer
fi
chmod -R ugo+rw /.composer

# ── 4. Fix de permisos en storage/ y bootstrap/cache ────
#    Esto garantiza que el usuario sail (www-data en algunos casos)
#    pueda leer/escribir en los directorios que Laravel necesita.
chown -R sail:sail /var/www/html/storage 2>/dev/null || true
chown -R sail:sail /var/www/html/bootstrap/cache 2>/dev/null || true
chmod -R u+w /var/www/html/storage 2>/dev/null || true
chmod -R u+w /var/www/html/bootstrap/cache 2>/dev/null || true

# ── 5. Asegurar que storage directories existan ─────────
mkdir -p /var/www/html/storage/framework/views \
    /var/www/html/storage/framework/cache \
    /var/www/html/storage/framework/sessions \
    /var/www/html/storage/logs \
    /var/www/html/bootstrap/cache

# ── 6. Crear symlink public/storage → storage/app/public ─
#    (solo si no existe ya)
if [ ! -L /var/www/html/public/storage ] && [ ! -d /var/www/html/public/storage ]; then
    ln -sf /var/www/html/storage/app/public /var/www/html/public/storage 2>/dev/null || true
fi

# ── 7. Ejecutar comando solicitado o supervisord ────────
if [ $# -gt 0 ]; then
    exec gosu $WWWUSER "$@"
else
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
